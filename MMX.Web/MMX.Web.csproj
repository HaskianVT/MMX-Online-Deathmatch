<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Browser build of the game: the MMX sources with the Platform/Web backend instead of Platform/Sfml -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MMXOnline</RootNamespace>
    <StartupObject>MMXOnline.WebMain</StartupObject>
    <DefineConstants>$(DefineConstants);WEB</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Compiles to native WebAssembly on publish (needs the wasm-tools workload); the interpreter is too slow for the game.
         AOT requires trimming, but the game relies on reflection (JSON with dynamic, protobuf), so only the framework
         assemblies are trimmed (partial mode) and the ones dynamic uses are kept whole below. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AssetsZip>$(MSBuildProjectDirectory)\wwwroot\assets.zip</AssetsZip>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\MMX\**\*.cs" Exclude="..\MMX\Platform\Sfml\**;..\MMX\bin\**;..\MMX\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used through reflection by dynamic (Newtonsoft's JObject in LevelData) -->
    <TrimmerRootAssembly Include="Microsoft.CSharp" />
    <TrimmerRootAssembly Include="System.Linq.Expressions" />
    <TrimmerRootAssembly Include="System.Dynamic.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeviceId" Version="6.0.0" />
    <PackageReference Include="GoogleAnalyticsTracker.Simple" Version="6.0.5" />
    <PackageReference Include="MathNet.Spatial" Version="0.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="Profanity.Detector" Version="0.1.8" />
    <PackageReference Include="protobuf-net" Version="3.0.101" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lidgren.Network\Lidgren.Network.csproj" />
  </ItemGroup>

  <!-- The game reads its assets from files, so main.js downloads them zipped and WebMain extracts them to the in-memory file system -->
  <Target Name="ZipAssets" BeforeTargets="Build" Condition="!Exists('$(AssetsZip)')">
    <ZipDirectory SourceDirectory="..\LevelEditor\assets" DestinationFile="$(AssetsZip)" />
  </Target>

</Project>
